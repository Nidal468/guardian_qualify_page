# --- Application ---
# MongoDB connection string (required). Never commit real values.
MONGO_URI="mongodb://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# Public domain, used for metadata/sitemap.
DOMAIN="qualify.guardian1st.io"

# --- Carla voice advisor ---
# AI backend base URL (required for live voice calls). Must include scheme.
AI_BACKEND="http://localhost:4006"
# Agent id served by the AI backend. Optional; code default applies if unset.
AGENT_ID=""
# TTS voice id. Optional; code default applies if unset.
VOICE_ID=""
# Minimum completed speech (chars) before TTS starts mid-stream. Lower = faster first audio, more clips.
SPEECH_BOUNDARY_CHARS="40"
# Service token for the AI backend (see SERVICE_AUTH in the backend's env; scopes: chat, tts).
AI_BACKEND_KEY=""
# CRM webhook for conversation notifications. Unset or empty disables notifications (fail closed).
CALL_WEBHOOK_URL=""
# Debug toggles (optional).
CALL_DEBUG="false"
NEXT_PUBLIC_CALL_DEBUG="false"

# --- GoHighLevel integration (used by /api/ghl-lookup) ---
GHL_API_KEY=""
GHL_LOCATION_ID=""
# Webhook trigger that receives quiz leads server-side. Unset = leads stored locally only.
GHL_LEAD_WEBHOOK_URL=""
# Public GHL chat widget id. Optional; widget script is omitted when unset.
NEXT_PUBLIC_GHL_WIDGET_ID=""
